{
  "name": "simbridge",
  "version": "0.0.0",
  "private": true,
  "description": "Build, run, test and debug Flutter and React Native iOS apps from a Windows PC, with no Mac on the desk.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MustafaDilawarKhan/simbridge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
